{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)\\.(md|csv|env|bat|bak|sql|log|sh)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(operacao_v2|scripts|knowledge_base|checkout|email|_internal_archive|10_CRIATIVOS_PARA_META_ADS)(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/oferta", "destination": "/" },
    { "source": "/painel", "destination": "/painel.html" },
    { "source": "/dashboard", "destination": "/painel.html" },
    { "source": "/app", "destination": "/app-dist/index" },
    { "source": "/jogar", "destination": "/app-dist/index" },
    { "source": "/download", "destination": "/Missao_Tabuada_Volume_1.pdf" },
    { "source": "/downlownd", "destination": "/Missao_Tabuada_Volume_1.pdf" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(painel|painel\\.html|dashboard|obrigado|obrigado\\.html|download|downlownd|.*\\.pdf)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(tabuada-assets|assets)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/app-dist/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|ico|mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
